# Template for credentials.env.
#
# Copy this file to credentials.env (in the same directory, or wherever
# CREDENTIAL_DOTENV_DIR points) and fill in real values. credentials.env is loaded
# by hazard.utilities.zarr_utilities.set_credential_env_variables().
#
# credentials.env itself is gitignored and should never be committed.

# Production (public) bucket -- required for copy_local_to_prod and, more generally,
# anywhere get_s3_fs/get_store are called with use_dev=False.
OSC_S3_ACCESS_KEY=
OSC_S3_SECRET_KEY=
OSC_S3_BUCKET=os-climate-physical-risk
# Optional: only needed for a non-AWS / custom S3-compatible endpoint.
OSC_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Development bucket (optional) -- required for copy_local_to_dev and anywhere
# get_s3_fs/get_store are called with use_dev=True (the default).
OSC_S3_ACCESS_KEY_DEV=
OSC_S3_SECRET_KEY_DEV=
OSC_S3_BUCKET_DEV=
# Optional: only needed for a non-AWS / custom S3-compatible endpoint.
OSC_S3_ENDPOINT_DEV=
